@model IEnumerable<LinkCare_IT15.Models.Billing>

@{
    ViewBag.Title = "Billing · Link Care";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* === Global Dashboard Styling (match Admin Dashboard) === */
    .dashboard-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

        .dashboard-header h4 {
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .dashboard-header .small {
            font-size: 0.95rem;
            opacity: 0.9;
        }

    .container-fluid {
        padding-top: 0.5rem !important;
    }

    /* === Card Styling (same as Admin Dashboard) === */
    .lc-card {
        background: #fff;
        border-radius: 1rem;
        padding: 1.5rem; /* match Admin Dashboard */
        border: 1px solid #f1f1f1;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .lc-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        }

    .lc-card-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #444;
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .metric-value {
        font-size: 1.9rem;
        font-weight: 700;
        color: #222;
        margin-bottom: 0.25rem;
    }

    .small-muted {
        color: #777;
        font-size: 0.85rem;
    }

    .text-gradient {
        background: linear-gradient(90deg, #007bff, #00c6ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }

    /* === Billing Items === */
    .billing-box {
        max-height: 400px;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

        .billing-box::-webkit-scrollbar {
            width: 6px;
        }

        .billing-box::-webkit-scrollbar-thumb {
            background-color: #007bff;
            border-radius: 10px;
        }

        .billing-box::-webkit-scrollbar-track {
            background-color: #f1f1f1;
        }

    .billing-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-radius: 1rem; /* match lc-card style */
        border: 1px solid #f1f1f1;
        background: #fff;
        margin-bottom: 0.75rem;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .billing-item:hover {
            background: #f9fbff;
            transform: translateY(-2px);
        }

    .badge-soft {
        background-color: rgba(0,123,255,0.1);
        color: #007bff;
        font-weight: 500;
    }

    .btn-outline-success {
        border-radius: 0.5rem;
    }

    /* === Search Bar === */
    .search-bar {
        max-width: 450px;
    }

    /* === Responsive adjustments === */
    @@media (max-width: 992px) {
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            text-align: left;
            gap: 0.5rem;
        }
    }

    @@media (max-width: 576px) {
        .dashboard-header {
            padding: 1rem 1.25rem;
            margin-top: 0.25rem;
        }

        .lc-card {
            padding: 1.25rem !important;
        }

        .metric-value {
            font-size: 1.6rem;
        }

        .billing-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

            .billing-item .d-flex {
                width: 100%;
                justify-content: space-between;
            }

        body {
            margin: 0;
            padding: 0;
        }

        .container-fluid {
            padding-top: 0 !important;
            padding-left: 2rem;
            padding-right: 2rem;
        }

        .dashboard-header {
            margin-top: 0;
        }

        .content {
            padding-top: 1rem; /* match admin dashboard */
        }
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="container-fluid mt-4 online-appointments-style px-0">
        <!-- Full-width Gradient Header -->
        <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="mb-0 fw-bold">Billing & Payments</h4>
                <div class="small">Manage patient bills and payment records</div>
            </div>
            <div><i class="bi bi-receipt fs-1 opacity-75"></i></div>
        </div>
    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="lc-card text-center">
                <div class="lc-card-title">Total Revenue</div>
                <div class="metric-value text-gradient">
                    ₱@String.Format("{0:n0}", Model.Where(b => b.Transactions.Any(t => t.Status.ToLower() == "paid")).Sum(b => b.TotalAmount))
                </div>
                <div class="small-muted">All paid bills</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="lc-card text-center">
                <div class="lc-card-title">Pending</div>
                <div class="metric-value text-warning">
                    ₱@String.Format("{0:n0}", Model.Where(b => !b.Transactions.Any(t => t.Status.ToLower() == "paid")).Sum(b => b.TotalAmount))
                </div>
                <div class="small-muted">Awaiting payment</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="lc-card text-center">
                <div class="lc-card-title">Total Bills</div>
                <div class="metric-value">@Model.Count()</div>
                <div class="small-muted">All time</div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <form method="get" class="mb-4 d-flex search-bar">
        <input type="text" name="search" value="@ViewContext.HttpContext.Request.Query["search"]"
               class="form-control me-2" placeholder="Search patient or walk-in..." />
        <button type="submit" class="btn btn-primary px-4">Search</button>
    </form>

    <!-- Billing List -->
    <div class="lc-card">
        <div class="lc-card-title mb-3 d-flex align-items-center">
            <i class="bi bi-receipt-cutoff me-2 text-primary"></i> Bill Records
        </div>

        <div class="billing-box">
            @if (Model.Any())
            {
                @foreach (var bill in Model)
                {
                    var status = bill.Transactions.Any(t => t.Status.ToLower() == "paid") ? "Paid" : "Pending";
                    var badgeClass = status == "Paid"
                    ? "bg-success-subtle text-success"
                    : "bg-warning-subtle text-warning";

                    <div class="billing-item">
                        <div>
                            <div class="fw-semibold text-primary">
                                <i class="bi bi-person me-1"></i>
                                @(bill.Patient != null
                                    ? $"{bill.Patient.FirstName} {bill.Patient.LastName}"
                                    : bill.WalkInName ?? "Walk-in")
                            </div>
                            <div class="small-muted">@bill.BillingDate.ToString("MMM dd, yyyy")</div>
                            <div class="fw-bold text-dark">₱@String.Format("{0:n2}", bill.TotalAmount)</div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill @badgeClass text-capitalize">@status</span>
                            @if (status == "Pending")
                            {
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#paymentModal"
                                        data-billing-id="@bill.BillingID"
                                        data-amount="@bill.TotalAmount">
                                    Pay Now
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted fst-italic">No billing records found.</div>
            }
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ProcessPayment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-cash-stack me-2"></i> Process Payment
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="billingId" name="billingId" />
                    <div class="mb-3">
                        <label class="form-label">Total Amount</label>
                        <input type="text" id="totalAmount" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount Paid</label>
                        <input type="number" step="0.01" class="form-control" name="amountPaid" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="">Select Method</option>
                            <option>Cash</option>
                            <option>GCash</option>
                            <option>Card</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reference Number (Optional)</label>
                        <input type="text" name="referenceNumber" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const paymentModal = document.getElementById('paymentModal');
        paymentModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const billingId = button.getAttribute('data-billing-id');
            const totalAmount = button.getAttribute('data-amount');

            document.getElementById('billingId').value = billingId;
            document.getElementById('totalAmount').value = '₱' + parseFloat(totalAmount).toFixed(2);
        });

        @if (TempData["Success"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["Success"]'
                    });
            </text>
        }
    </script>
}
