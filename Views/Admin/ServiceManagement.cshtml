@model IEnumerable<LinkCare_IT15.Models.Service>

@{
    ViewBag.Title = "Service Management · Link Care";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* === Dashboard Header === */
    .dashboard-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .dashboard-header h3 {
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .dashboard-header .small {
            color: rgba(255, 255, 255, 0.85);
        }

        .dashboard-header .btn-add-item {
            background-color: rgba(255, 255, 255, 0.9);
            color: #4facfe;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .dashboard-header .btn-add-item:hover {
                background-color: white;
                color: #007bff;
            }

    /* === Responsive Grid for Cards === */
    .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
        transition: all 0.25s ease;
    }

    /* === When sidebar is collapsed, shrink the cards slightly === */
    body.sidebar-collapsed .service-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
    }

    /* === Card Styles === */
    .lc-card {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .lc-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }

        .lc-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
        }

    .lc-card-title {
        font-weight: 600;
        color: #333;
        font-size: 1.05rem;
    }

    .small-muted {
        font-size: 0.9rem;
        color: #777;
    }

    /* === Buttons === */
    .btn {
        border-radius: 0.6rem !important;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        transition: all 0.2s ease;
    }

    .btn-outline-primary {
        border-color: #4facfe;
        color: #4facfe;
    }

        .btn-outline-primary:hover {
            background-color: #4facfe;
            color: white;
        }

    .btn-outline-success {
        border-color: #00c16a;
        color: #00c16a;
    }

        .btn-outline-success:hover {
            background-color: #00c16a;
            color: white;
        }

    /* === Active / Inactive === */
    .btn-success, .btn-secondary {
        min-width: 100px;
        font-weight: 500;
    }

    /* === Empty State === */
    .empty-state {
        text-align: center;
        color: #888;
        padding: 2rem 0;
    }

        .empty-state i {
            font-size: 2rem;
            color: #ccc;
            display: block;
            margin-bottom: 0.5rem;
        }

    /* === Modal Styling === */
    .modal-header.bg-primary {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%) !important;
    }

    .form-label {
        font-weight: 500;
        color: #333;
    }

    .form-control, .form-select {
        border-radius: 0.6rem;
        border: 1px solid #ddd;
        padding: 0.5rem 0.75rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #4facfe;
            box-shadow: 0 0 0 2px rgba(79, 172, 254, 0.3);
        }

    /* === Responsive Fixes === */
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .dashboard-header h3 {
                font-size: 1.3rem;
            }
    }
</style>


<div class="container-fluid mt-4">

    <div class="dashboard-header">
        <div>
            <h3>Service Management</h3>
            <div class="small">Manage and maintain all services offered in the clinic</div>
        </div>
        <button class="btn btn-add-item" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="bi bi-plus-lg"></i> Add Service
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="service-grid">
        @if (Model.Any())
        {
            @foreach (var service in Model)
            {
                <div class="lc-card">
                    @if (!string.IsNullOrEmpty(service.ImagePath))
                    {
                        <img src="@service.ImagePath" alt="@service.ServiceName" />
                    }
                    else
                    {
                        <div class="bg-light d-flex justify-content-center align-items-center" style="height:160px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }

                    <div class="p-3 flex-grow-1">
                        <div class="lc-card-title">@service.ServiceName</div>
                        <p class="small-muted mb-1">@service.Description</p>
                        <p class="small-muted"><strong>Duration:</strong> @service.DurationMinutes mins</p>
                    </div>

                    <div class="p-3 d-flex justify-content-between align-items-center border-top">
                        <button class="btn @(service.IsActive ? "btn-success" : "btn-secondary") btn-sm"
                                onclick="toggleService(@service.ServiceId, this)">
                            @(service.IsActive ? "Active" : "Inactive")
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-gear"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="#" onclick="openEditModal(@service.ServiceId)">
                                        <i class="bi bi-pencil me-2"></i>Edit
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state w-100">
                <i class="bi bi-inbox"></i>No services found.
            </div>
        }
    </div>
</div>

<!-- === Add & Edit Modals (same as before) === -->
@* Keep your AddServiceModal and EditServiceModal code blocks unchanged *@
<!-- ===================== Add Service Modal ===================== -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-action="AddService" asp-controller="Service" method="post" enctype="multipart/form-data">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addServiceModalLabel">Add New Service</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Service Name</label>
                        <input type="text" name="ServiceName" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Duration (minutes)</label>
                        <input type="number" name="DurationMinutes" class="form-control" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        <input type="file" id="imageInput" name="ImageFile" class="form-control" accept="image/*">
                        <img id="imagePreview" src="#" alt="Preview" class="mt-2 rounded" style="display:none; max-height:150px;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================== Edit Service Modal ===================== -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-action="EditService" asp-controller="Service" method="post" enctype="multipart/form-data">
                <input type="hidden" id="editServiceId" name="ServiceId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Service Name</label>
                        <input type="text" id="editServiceName" name="ServiceName" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="editDescription" name="Description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Duration (minutes)</label>
                        <input type="number" id="editDuration" name="DurationMinutes" class="form-control" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        <input type="file" id="editImageInput" name="ImageFile" class="form-control" accept="image/*">
                        <img id="editImagePreview" src="#" alt="Preview" class="mt-2 rounded" style="display:none; max-height:150px;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Toggle Active / Inactive
        function toggleService(serviceId, btn) {
            fetch(`/Admin/Service/ToggleStatus/${serviceId}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        btn.textContent = data.isActive ? "Active" : "Inactive";
                        btn.classList.toggle("btn-success", data.isActive);
                        btn.classList.toggle("btn-secondary", !data.isActive);
                    }
                });
        }

        // Image preview - Add modal
        document.getElementById('imageInput').addEventListener('change', e => {
            const file = e.target.files[0];
            const preview = document.getElementById('imagePreview');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            } else preview.style.display = 'none';
        });

        // Image preview - Edit modal
        document.getElementById('editImageInput').addEventListener('change', e => {
            const file = e.target.files[0];
            const preview = document.getElementById('editImagePreview');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            } else preview.style.display = 'none';
        });

        // Load service for edit
        function openEditModal(id) {
            fetch(`/Admin/Service/GetService/${id}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('editServiceId').value = data.serviceId;
                    document.getElementById('editServiceName').value = data.serviceName;
                    document.getElementById('editDescription').value = data.description;
                    document.getElementById('editDuration').value = data.durationMinutes;

                    const preview = document.getElementById('editImagePreview');
                    if (data.imagePath) {
                        preview.src = data.imagePath;
                        preview.style.display = 'block';
                    } else preview.style.display = 'none';

                    const modal = new bootstrap.Modal(document.getElementById('editServiceModal'));
                    modal.show();
                });
        }
    </script>
}