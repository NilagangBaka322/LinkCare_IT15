    <!-- === Financial Breakdown === -->
    <section>
        <h3 class="fw-bold mb-3">Financial Summary Breakdown</h3>
        <table class="summary-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Amount (₱)</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Billings (Income)</td>
                    <td>@Model.TotalBilling.ToString("N2")</td>
                    <td>Revenue from patient services</td>
                </tr>
                <tr>
                    <td>Equipment Cost</td>
                    <td>@Model.TotalEquipmentCost.ToString("N2")</td>
                    <td>Machinery, diagnostics, and devices</td>
                </tr>
                <tr>
                    <td>Consumables</td>
                    <td>@Model.TotalConsumableCost.ToString("N2")</td>
                    <td>Medical supplies and disposables</td>
                </tr>
                <tr style="border-top: 2px solid #ccc;">
                    <td><strong>Net Revenue</strong></td>
                    <td><strong>@Model.NetRevenue.ToString("N2")</strong></td>
                    <td>Total profit after expenses</td>
                </tr>
            </tbody>
        </table>
    </section>
</div>

<div class="container-fluid">
    <!-- === Financial Overview Cards === -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="lc-card bg-revenue">
                <div class="lc-label">Total Revenue</div>
                <div class="lc-value">₱@Model.TotalRevenue.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="lc-card bg-equipment">
                <div class="lc-label">Equipment Cost</div>
                <div class="lc-value">₱@Model.TotalEquipmentCost.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="lc-card bg-consumables">
                <div class="lc-label">Consumables Cost</div>
                <div class="lc-value">₱@Model.TotalConsumableCost.ToString("N2")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="lc-card bg-net">
                <div class="lc-label">Net Revenue</div>
                <div class="lc-value">₱@Model.NetRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- === Operational Summary === -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="lc-card">
                <div class="lc-label">Total Appointments</div>
                <div class="lc-value">@Model.TotalAppointments</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="lc-card">
                <div class="lc-label">Consultations</div>
                <div class="lc-value">@Model.TotalConsultations</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="lc-card">
                <div class="lc-label">Total Patients</div>
                <div class="lc-value">@Model.TotalPatients</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="lc-card">
                <div class="lc-label">Active Doctors</div>
                <div class="lc-value">@Model.ActiveDoctors</div>
            </div>
        </div>
    </div>

    <!-- === Charts Section === -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="chart-container">
                <h5 class="fw-bold mb-3">Monthly Revenue Trend</h5>
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-container">
                <h5 class="fw-bold mb-3">Patient Breakdown</h5>
                <canvas id="patientChart"></canvas>
            </div>
        </div>
    </div>

    <!-- === Detailed Financial Breakdown === -->
    <div class="lc-card mt-4">
        <h5 class="fw-bold mb-3">Financial Summary Breakdown</h5>
        <table class="summary-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Amount (₱)</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Billings (Income)</strong></td>
                    <td>@Model.TotalBilling.ToString("N2")</td>
                    <td>Total charges collected from patients and services</td>
                </tr>
                <tr>
                    <td>Equipment Cost</td>
                    <td>@Model.TotalEquipmentCost.ToString("N2")</td>
                    <td>Purchased clinic machines and tools</td>
                </tr>
                <tr>
                    <td>Consumables Cost</td>
                    <td>@Model.TotalConsumableCost.ToString("N2")</td>
                    <td>Supplies, gloves, syringes, etc.</td>
                </tr>
                <tr style="border-top: 2px solid #ccc;">
                    <td><strong>Net Revenue</strong></td>
                    <td><strong>@Model.NetRevenue.ToString("N2")</strong></td>
                    <td>Revenue - (Equipment + Consumables)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        function printReportSection() {
            window.print();
        }
        // === Net Revenue Bar Chart (Single Value) ===
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: ['Net Revenue'], // Only one label
                datasets: [{
                    label: 'Net Revenue (₱)',
                    data: [@Model.TotalRevenue], // Single value in array
                    backgroundColor: 'rgba(76, 175, 80, 0.6)',
                    borderColor: '#4caf50',
                    borderWidth: 1
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true },
                    x: { ticks: { color: '#555' } }
                }
            }
        });

        // === Patient Breakdown Chart ===
        const patientCtx = document.getElementById('patientChart').getContext('2d');
        new Chart(patientCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Patients.Select(p => p.Category))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Patients.Select(p => p.Count))),
                    backgroundColor: ['#42a5f5', '#66bb6a', '#ffa726', '#ab47bc'],
                    borderWidth: 1
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}


