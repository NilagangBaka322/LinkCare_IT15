@model IEnumerable<LinkCare_IT15.Models.PatientModel.RecordViewModel>

@{
    ViewBag.Title = "My Medical Records · Link Care";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* === Shared Modern Design (from Dashboard) === */
    .dashboard-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .lc-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
    }

        .lc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }

    .lc-card-title {
        font-weight: 600;
        color: #444;
        font-size: 1rem;
        letter-spacing: 0.2px;
    }

    .text-muted {
        color: #777 !important;
    }

    .small-muted {
        color: #888;
        font-size: 0.9rem;
    }

    .badge-soft {
        background-color: #e9f5ff;
        color: #007bff;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
    }
</style>

<div class="container-fluid">
    <!-- Gradient Header -->
    <div class="dashboard-header d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">My Medical Records</h4>
            <div class="small">View your consultation history and medical notes</div>
        </div>
        <div><i class="bi bi-clipboard2-pulse fs-1 opacity-75"></i></div>
    </div>

    <!-- Card Content -->
    <div class="lc-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="lc-card-title mb-1">Medical History</h5>
                <p class="text-muted mb-0">Your past consultations and health records</p>
            </div>
            <i class="bi bi-journal-medical text-primary fs-5"></i>
        </div>

        <!-- Search + Filter -->
        <form method="get" asp-action="PatientRecords" class="d-flex flex-wrap mb-4 align-items-center">
            <div class="me-auto mb-2 d-flex align-items-center" style="gap: 8px;">
                <input type="text" name="search" value="@ViewBag.SearchQuery"
                       class="form-control form-control-sm"
                       placeholder="Search by diagnosis or doctor name..."
                       style="width: 320px; height: 34px; font-size: 0.9rem; border-radius: 8px;" />

                <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center px-3" style="height: 34px;">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>

            <div>
                <select class="form-select form-select-sm" style="height: 34px; border-radius: 8px;">
                    <option>All Records</option>
                    <option>With Prescriptions</option>
                    <option>Without Prescriptions</option>
                </select>
            </div>
        </form>


        <!-- Records Table -->
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Chief Complaint</th>
                        <th>Diagnosis</th>
                        <th>Prescriptions</th>
                        <th>Vitals</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var record in Model)
                        {
                            <tr>
                                <td>@record.DoctorName</td>
                                <td>@record.ConsultationDate.ToString("MMM dd, yyyy")</td>
                                <td>@record.ChiefComplaint</td>
                                <td>@record.Diagnosis</td>
                                <td>
                                    @if (record.Prescriptions != null && record.Prescriptions.Any())
                                    {
                                        foreach (var med in record.Prescriptions)
                                        {
                                            <span class="badge bg-light text-dark me-1">@med</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td>
                                    <div><strong>BP:</strong> @record.BloodPressure</div>
                                    <div><strong>HR:</strong> @record.HeartRate</div>
                                    <div><strong>T:</strong> @record.Temperature °C</div>
                                    <div><strong>W:</strong> @record.Weight kg</div>
                                </td>
                                <td>@record.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-file-earmark-x fs-4 d-block mb-2"></i>
                                No medical records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

   
</div>
