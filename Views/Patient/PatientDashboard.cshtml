@model LinkCare_IT15.Models.PatientModel.PatientDashboardModel

@{
    ViewBag.Title = "Patient Dashboard · Link Care";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* === Unified Modern Design === */
    .dashboard-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .lc-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
        height: 100%;
        padding: 1.75rem !important;
    }

        .lc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }

    /* === KPI CARD STRUCTURE === */
    .metric-card {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 0.75rem;
    }

    .metric-header {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .metric-icon {
        font-size: 1.4rem;
        color: #0d6efd;
    }

    .metric-title {
        font-weight: 600;
        color: #333;
        font-size: 1rem;
    }

    .metric-value {
        display: block;
        width: 100%;
        text-align: right;
        font-size: 1.8rem;
        font-weight: 700;
        color: #222;
    }

    .metric-subtext {
        text-align: left;
        font-size: 0.9rem;
        color: #666;
        margin-top: 0.25rem;
    }

    .badge-soft {
        background-color: #e9f5ff;
        color: #007bff;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
    }

    /* === Appointments List === */
    .list-plain {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .list-plain li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 0;
            border-bottom: 1px solid #f1f1f1;
        }

            .list-plain li:last-child {
                border-bottom: none;
            }

    /* === Consistent Vertical Spacing === */
    /* Use equal vertical gutter for all rows */
    .row.g-3 {
        --bs-gutter-x: 1.5rem;
        --bs-gutter-y: 1.75rem; /* matches header spacing */
    }

    /* Remove extra top margin from second row to avoid double spacing */
    .section-spacing {
        margin-top: 0 !important;
    }

    /* === Responsive Equal Height for Bottom Cards === */
    @@media (min-width: 992px) {
        .col-lg-8,
        .col-lg-4 {
            display: flex;
        }

        .lc-card {
            flex: 1;
        }
    }
</style>


<div class="container-fluid">

    <!-- === Header === -->
    <div class="dashboard-header d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">Welcome Back, Patient User</h4>
            <div class="small">Here's your health overview.</div>
        </div>
        <div><i class="bi bi-heart-pulse fs-1 opacity-75"></i></div>
    </div>

    <!-- === KPI Cards === -->
    <div class="row g-3">
        <!-- Next Appointment -->
        <div class="col-12 col-lg-4">
            <div class="lc-card p-4 metric-card">
                <div class="metric-header">
                    <i class="bi bi-calendar3 metric-icon"></i>
                    <div class="metric-title">Next Appointment</div>
                </div>

                <div class="metric-value text-primary">
                    @if (Model.NextAppointment != null)
                    {
                        @Model.NextAppointment.Start.ToString("MMM dd")
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>

                <div class="metric-subtext">
                    @if (Model.NextAppointment != null)
                    {
                        @($"{Model.NextAppointment.Start:hh:mm tt} with {Model.NextAppointment.Doctor}")
                    }
                    else
                    {
                        <span class="text-muted">No upcoming appointments</span>
                    }
                </div>
            </div>
        </div>

        <!-- Medical Records -->
        <div class="col-12 col-lg-4">
            <div class="lc-card p-4 metric-card">
                <div class="metric-header">
                    <i class="bi bi-clipboard2-pulse metric-icon"></i>
                    <div class="metric-title">Medical Records</div>
                </div>

                <div class="metric-value">@Model.TotalConsultations</div>
                <div class="metric-subtext">Total consultations</div>
            </div>
        </div>

        <!-- Outstanding Bills -->
        <div class="col-12 col-lg-4">
            <div class="lc-card p-4 metric-card">
                <div class="metric-header">
                    <i class="bi bi-receipt metric-icon text-danger"></i>
                    <div class="metric-title">Outstanding Bills</div>
                </div>

                <div class="metric-value text-danger">
                    ₱@String.Format("{0:n0}", Model.OutstandingBills)
                </div>
                <div class="metric-subtext">@Model.PendingPayments pending payment</div>
            </div>
        </div>
    </div>

    <!-- === Upcoming Appointments & Health Tip === -->
    <div class="row g-3 section-spacing">
        <!-- Upcoming Appointments -->
        <div class="col-12 col-lg-8">
            <div class="lc-card p-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-clock-history text-primary fs-5 me-2"></i>
                    <div class="fw-semibold text-dark mb-0">Upcoming Appointments</div>
                </div>

                @if (Model.UpcomingAppointments != null && Model.UpcomingAppointments.Any())
                {
                    <ul class="list-plain">
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            <li>
                                <div>
                                    <div class="fw-semibold text-dark">@appt.Title</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar2 me-1"></i>
                                        @appt.Start.ToString("MMM dd, yyyy · h:mm tt")
                                    </div>
                                </div>
                                <span class="badge rounded-pill badge-soft">Scheduled</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-calendar-x display-6 d-block mb-2"></i>
                        <p>No upcoming appointments found.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Health Tip -->
        <div class="col-12 col-lg-4">
            <div class="lc-card p-4 text-center h-100">
                <i class="bi bi-heart-pulse text-danger fs-2 mb-2"></i>
                <h6 class="fw-bold text-dark mb-2">Health Tip</h6>
                <p class="text-muted small mb-0">
                    Stay hydrated, eat balanced meals, and get enough rest. Regular checkups help keep you healthy.
                </p>
            </div>
        </div>
    </div>

</div>
