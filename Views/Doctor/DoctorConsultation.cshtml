@model LinkCare_IT15.Models.ViewModels.DoctorConsultationViewModel

@using System.Security.Claims

@{
    ViewBag.Title = "Consultations · Link Care";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold">Consultations</h3>
            <p class="text-muted">Manage patient consultations and medical history</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Print Consultations
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newConsultationModal">
                <i class="bi bi-plus-circle me-1"></i> New Consultation
            </button>
        </div>
    </div>

    <!-- Consultation Records -->
    <div class="lc-card p-4">
        <h5 class="mb-3">Consultation Records</h5>
        <p class="text-muted">Your recorded consultations with patients</p>

        @if (Model.Consultations != null && Model.Consultations.Any())
        {
            foreach (var consult in Model.Consultations)
            {
                <div class="list-group-item">
                    <strong>@(consult.Patient?.FullName ?? "Walk-in")</strong><br />
                    <small>
                        Dr. @(consult.Doctor?.FullName ?? "Unknown") • @consult.Date.ToString("yyyy-MM-dd") • @consult.Diagnosis
                    </small>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted p-4">No consultations found.</div>
        }
    </div>
</div>

<!-- New Consultation Modal -->
<div class="modal fade" id="newConsultationModal" tabindex="-1" aria-labelledby="newConsultationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">New Medical Consultation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="AddConsultation" method="post">
                <!-- Hidden fields -->
                <input type="hidden" name="DoctorId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />

                <!-- Patient (manual entry for now, later can be dropdown/search) -->
                <div class="mb-3">
                    <label class="form-label">Patient ID</label>
                    <input type="text" class="form-control" name="PatientId" placeholder="Enter Patient ID (optional)" />
                </div>

                <!-- Chief Complaint -->
                <div class="mb-3">
                    <label class="form-label">Chief Complaint *</label>
                    <textarea class="form-control" name="ChiefComplaint" placeholder="Chief Complaint" required></textarea>
                </div>

                <!-- Diagnosis -->
                <div class="mb-3">
                    <label class="form-label">Diagnosis *</label>
                    <textarea class="form-control" name="Diagnosis" placeholder="Diagnosis" required></textarea>
                </div>

                <!-- Prescriptions -->
                <div id="prescriptionsContainer" class="mb-3">
                    <input type="text" class="form-control mb-2" name="Prescriptions" placeholder="Prescription 1" />
                </div>
                <button type="button" id="addPrescriptionBtn" class="btn btn-sm btn-outline-secondary mb-3">
                    Add Prescription
                </button>

                <!-- Notes -->
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" name="Notes" placeholder="Additional notes"></textarea>
                </div>

                <!-- Vitals -->
                <div class="mb-3">
                    <label class="form-label">Blood Pressure</label>
                    <input type="text" class="form-control" name="BloodPressure" placeholder="Blood Pressure" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Heart Rate</label>
                    <input type="text" class="form-control" name="HeartRate" placeholder="Heart Rate" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Temperature</label>
                    <input type="text" class="form-control" name="Temperature" placeholder="Temperature" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Weight</label>
                    <input type="text" class="form-control" name="Weight" placeholder="Weight" />
                </div>

                <button type="submit" class="btn btn-primary">Save Consultation</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const addPrescriptionBtn = document.getElementById("addPrescriptionBtn");
            const prescriptionsContainer = document.getElementById("prescriptionsContainer");

            addPrescriptionBtn?.addEventListener("click", function () {
                const count = prescriptionsContainer.querySelectorAll("input").length + 1;
                const input = document.createElement("input");
                input.type = "text";
                input.name = "Prescriptions";
                input.className = "form-control mb-2";
                input.placeholder = "Prescription " + count;
                prescriptionsContainer.appendChild(input);
            });
        });
    </script>
}
