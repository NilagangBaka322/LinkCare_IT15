@model LinkCare_IT15.Models.ViewModels.DoctorConsultationVM

@{
    ViewBag.Title = "Consultations · Link Care";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="container-fluid">
    <div class="mb-3">
        <h3 class="fw-bold">Consultations</h3>
        <p class="text-muted">Manage patient consultations and medical history</p>
    </div>

    @* Add Bootstrap Icons if not already included *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Search Bar -->
    <div class="input-group mb-4">
        <span class="input-group-text bg-primary text-white">
            <i class="bi bi-search"></i>
        </span>
        <input type="text" id="searchConsultations" class="form-control" placeholder="Search by patient name or complaint..." />
    </div>
    <!-- Consultation Records -->
    <div class="lc-card p-4">
        <h5 class="mb-3 fs-4 fw-bold">Consultation Records</h5>
        <p class="text-muted">Your recorded consultations with patients</p>

        @if (Model.Consultations != null && Model.Consultations.Any())
        {
            <div class="accordion consultation-accordion" id="consultationAccordion">
                @for (int i = 0; i < Model.Consultations.Count; i++)
                {
                    var consult = Model.Consultations[i];
                    var collapseId = $"collapse{i}";
                    var headingId = $"heading{i}";

                    <div class="accordion-item mb-3 shadow-sm rounded-3 border-0">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed d-flex justify-content-between align-items-center py-3 fs-5"
                                    type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="false" aria-controls="@collapseId">

                                <div>
                                    <strong>
                                        @(string.IsNullOrEmpty(consult.PatientName)
                                            ? (consult.AppointmentPatientName ?? "Walk-in")
                                            : consult.PatientName)
                                    </strong>

                                    <div class="small text-muted">
                                        @consult.Date.ToString("yyyy-MM-dd") • @consult.Date.ToString("HH:mm")
                                        <span class="mx-2 text-secondary">|</span>
                                        <em>@consult.ChiefComplaint</em>
                                    </div>

                                </div>

                               
                            </button>
                        </h2>

                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#consultationAccordion">
                            <div class="accordion-body">

                                <div class="mb-3">
                                    <strong>Chief Complaint:</strong>
                                    <div class="mt-1 ps-2 border-start border-3 border-primary">
                                        @consult.ChiefComplaint
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <strong>Diagnosis:</strong>
                                    <div class="mt-1 ps-2 border-start border-3 border-danger">
                                        @consult.Diagnosis
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(consult.Prescriptions))
                                {
                                    <div class="mb-3">
                                        <strong>Prescription:</strong>
                                        <div class="mt-2 d-flex flex-wrap gap-2">
                                            @{
                                                var prescriptions = consult.Prescriptions
                                                .Split(new[] { ',', ';', '|', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                                .Select(p => p.Trim())
                                                .Where(p => !string.IsNullOrEmpty(p))
                                                .ToList();

                                                foreach (var p in prescriptions)
                                                {
                                                    <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                                                        <i class="bi bi-capsule me-1"></i> @p
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </div>
                                }


                                <div class="d-flex justify-content-between text-center bg-light p-3 rounded-3 mb-3">
                                    <div>
                                        <i class="bi bi-activity vital-icon text-primary" aria-hidden="true"></i>
                                        <div class="small text-muted">Blood Pressure</div>
                                        <div class="fw-semibold">@consult.BloodPressure</div>
                                    </div>
                                    <div>
                                        <i class="bi bi-heart-fill vital-icon text-danger" aria-hidden="true"></i>
                                        <div class="small text-muted">Heart Rate</div>
                                        <div class="fw-semibold">@consult.HeartRate bpm</div>
                                    </div>
                                    <div>
                                        <i class="bi bi-thermometer-half vital-icon text-warning" aria-hidden="true"></i>
                                        <div class="small text-muted">Temperature</div>
                                        <div class="fw-semibold">@consult.Temperature °C</div>
                                    </div>
                                    <div>
                                        @* Reliable weighing-scale display: emoji fallback (always shows) *@
                                        <span class="vital-icon" aria-hidden="true">⚖️</span>
                                        <div class="small text-muted">Weight</div>
                                        <div class="fw-semibold">@consult.Weight kg</div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(consult.Notes))
                                {
                                    <div>
                                        <strong>Notes:</strong>
                                        <div class="mt-1 ps-2 border-start border-3 border-info">
                                            @consult.Notes
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted p-4">No consultations found.</div>
        }
    </div>

</div>
<!-- New Consultation Modal -->
<div class="modal fade" id="newConsultationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">New Medical Consultation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="AddConsultation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewConsultation.AppointmentId" />

                <div class="modal-body">
                    <!-- Patient Selection -->
                    <div class="mb-3">
                        <label class="form-label">Patient</label>

                        @if (Model.NewConsultation.AppointmentId != null)
                        {
                                <!-- Auto-filled from appointment -->
                                <input type="text" class="form-control"
                                       value="@(Model.NewConsultation.PatientId != null
                                            ? Model.Patients.FirstOrDefault(p => p.Value == Model.NewConsultation.PatientId)?.Text
                                            : "Walk-in")"
                                       readonly />
                                <input type="hidden" asp-for="NewConsultation.PatientId" />
                        }
                        else
                        {
                                <!-- Choose registered patient or walk-in -->
                                <select asp-for="NewConsultation.PatientId" class="form-select">
                                    <option value="">-- Walk-in (No Record) --</option>
                                @foreach (var patient in Model.Patients)
                                {
                                            <option value="@patient.Value">@patient.Text</option>
                                }
                                </select>
                        }
                    </div>

                    <!-- Complaint + Diagnosis -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewConsultation.ChiefComplaint" class="form-label"></label>
                            <input asp-for="NewConsultation.ChiefComplaint" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewConsultation.Diagnosis" class="form-label"></label>
                            <textarea asp-for="NewConsultation.Diagnosis" class="form-control"></textarea>
                        </div>
                    </div>

                    <!-- Prescriptions -->
                    <div class="mb-3">
                        <label class="form-label">Prescriptions</label>
                        <div id="prescriptionsContainer">
                            <input type="text" name="NewConsultation.Prescriptions[0]" class="form-control mb-2" placeholder="Prescription 1" />
                        </div>
                        <button type="button" id="addPrescriptionBtn" class="btn btn-sm btn-outline-primary">+ Add Prescription</button>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label asp-for="NewConsultation.Notes" class="form-label"></label>
                        <textarea asp-for="NewConsultation.Notes" class="form-control"></textarea>
                    </div>

                    <!-- Vitals -->
                    <h5>Vitals</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <input asp-for="NewConsultation.BloodPressure" class="form-control" placeholder="BP" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <input asp-for="NewConsultation.HeartRate" class="form-control" placeholder="HR" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <input asp-for="NewConsultation.Temperature" class="form-control" placeholder="Temp" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <input asp-for="NewConsultation.Weight" class="form-control" placeholder="Weight" />
                        </div>
                    </div>

                    <!-- Payment -->
                    <div class="mb-3">
                        <label asp-for="NewConsultation.ConsultationFee" class="form-label fw-semibold">Payment Amount (₱)</label>
                        <input asp-for="NewConsultation.ConsultationFee" type="number" step="0.01" min="0" class="form-control" placeholder="Enter payment amount" />
                        <span asp-validation-for="NewConsultation.ConsultationFee" class="text-danger"></span>
                    </div>


                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Consultation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 🩺 Auto-open modal if AppointmentId exists
            var appointmentId = '@Model.NewConsultation.AppointmentId';
            if (appointmentId && appointmentId !== "0") {
                var modal = new bootstrap.Modal(document.getElementById('newConsultationModal'));
                modal.show();
            }

            // 💊 Add Prescription dynamic input
            const addPrescriptionBtn = document.getElementById("addPrescriptionBtn");
            const prescriptionsContainer = document.getElementById("prescriptionsContainer");

            addPrescriptionBtn?.addEventListener("click", function () {
                const count = prescriptionsContainer.querySelectorAll("input").length;
                const input = document.createElement("input");
                input.type = "text";
                input.name = "NewConsultation.Prescriptions[" + count + "]";
                input.className = "form-control mb-2";
                input.placeholder = "Prescription " + (count + 1);
                prescriptionsContainer.appendChild(input);
            });

            // 🔍 Search Consultation Records (by name or complaint)
            const searchInput = document.getElementById("searchConsultations");
            const accordionItems = document.querySelectorAll(".consultation-accordion .accordion-item");

            searchInput?.addEventListener("input", function () {
                const query = this.value.toLowerCase().trim();
                let visibleCount = 0;

                accordionItems.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    const match = text.includes(query);
                    item.style.display = match ? "" : "none";
                    if (match) visibleCount++;
                });

                // Optional: show "No results" message
                const noResults = document.getElementById("noResults");
                if (noResults) {
                    noResults.style.display = visibleCount ? "none" : "";
                }
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <text>
            Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["Success"]'
            });
        </text>
    }
    @if (TempData["Error"] != null)
    {
        <text>
            Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]'
            });
        </text>
    }

    <partial name="_ValidationScriptsPartial" />
}


