@model LinkCare_IT15.Models.DoctorModel.DoctorPatientsModel

@{
    ViewBag.Title = "Patients · Link Care";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-3">
        <h3 class="fw-bold">Patients</h3>
        <p class="text-muted">Manage and view patient consultation prompts.</p>
    </div>

    <div class="lc-card p-4 shadow-sm rounded-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 d-flex align-items-center">
                <i class="bi bi-people me-2"></i> My Patients
            </h5>
        </div>

        <p class="text-muted mb-3">@Model.TotalPatients total patients</p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Upcoming Visit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Patients != null && Model.Patients.Any())
                    {
                        foreach (var p in Model.Patients)
                        {
                            var badgeClass = p.Status switch
                            {
                                "Completed" => "bg-success-subtle text-success",
                                "Scheduled" => "bg-primary-subtle text-primary",
                                "Rescheduled" => "bg-warning-subtle text-warning",
                                "Cancelled" => "bg-danger-subtle text-danger"
                                
                            };

                            <tr>
                                <td class="fw-semibold">@p.PatientName</td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass">@p.Status</span>
                                </td>
                                <td>@p.LastVisit.ToString("MMM dd, yyyy hh:mm tt")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">
                                No patient records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
