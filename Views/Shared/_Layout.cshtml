@using Microsoft.AspNetCore.Identity
@using LinkCare_IT15.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkCare_IT15</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LinkCare_IT15.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        /* HEADER */
        .navbar-custom {
            background: linear-gradient(135deg, #08a8e7, #2a2a2a);
        }

            .navbar-custom .navbar-brand {
                color: #fff;
                font-weight: bold;
                font-size: 1.4rem;
            }

                .navbar-custom .navbar-brand:hover {
                    color: #ff7979;
                }

            .navbar-custom .nav-link {
                color: #f8f9fa !important;
                transition: color 0.3s ease;
            }

                .navbar-custom .nav-link:hover {
                    color: #ff7979 !important;
                }

        .navbar-toggler {
            border: none;
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        /* FOOTER */
        footer {
            background-color: #2a2a2a;
            color: #f8f9fa;
        }

            footer a {
                color: #08a8e7;
                text-decoration: none;
            }

                footer a:hover {
                    color: #ff7979;
                }

            footer .social-icons a {
                font-size: 1.4rem;
                margin-left: 15px;
                color: #08a8e7;
                transition: color 0.3s ease;
            }

                footer .social-icons a:hover {
                    color: #ff7979;
                }
    </style>
</head>
<link rel="shortcut icon" href="~/LinkcareLogo.ico" type="image/x-icon" />

<body>
    <!-- HEADER / NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm fixed-top">
            <div class="container-fluid">
                <!-- Brand -->
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">Link Care</a>

                <!-- Navbar Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- LEFT aligned links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Privacy", "Home")">Privacy</a>
                        </li>

                        @* Show dashboard based on role *@
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="AdminDashboard">Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Doctor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Doctor" asp-action="DoctorDashboard">Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Patient"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Patient" asp-action="PatientDashboard">Dashboard</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- RIGHT aligned login/register -->
                    <div class="d-flex ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main role="main" class="container" style="padding-top: 100px; padding-bottom: 20px;">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="py-4 mt-5 border-top">
        <div class="container">
            <div class="row align-items-center">
                <!-- Left Side: Brand -->
                <div class="col-12 col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="fw-bold mb-1" style="color:#08a8e7;">Link Care</h5>
                    <p class="text-muted mb-0">Your trusted partner in health and wellness.</p>
                </div>

                <!-- Right Side: Links + Socials -->
                <div class="col-12 col-md-6 text-center text-md-end">
                    <a href="@Url.Action("Index", "Home")" class="me-3 d-block d-md-inline">Home</a>
                    <a href="@Url.Action("Privacy", "Home")" class="d-block d-md-inline">Privacy</a>
                    <div class="social-icons d-block mt-3 mt-md-0 d-md-inline">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
            </div>

            <!-- Bottom Text -->
            <div class="text-center mt-3 small text-muted">
                &copy; @DateTime.Now.Year Link Care. All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

