@* Views/Shared/_AdminLayout.cshtml *@
@{
    Layout = null;
    var title = ViewBag.Title as string ?? "Link Care · Smart Clinic System";
    var activePage = ViewData["ActivePage"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Bootstrap 5 + Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --lc-primary: #3b82f6;
            --lc-primary-600: #2563eb;
            --lc-bg: #f8fafc;
            --lc-card: #ffffff;
            --lc-border: #e5e7eb;
            --lc-text: #0f172a;
        }

        body {
            background: var(--lc-bg);
            color: var(--lc-text);
        }

        /* === Layout === */
        .lc-shell {
            display: grid;
            grid-template-columns: 260px 1fr;
            min-height: 100vh;
            transition: grid-template-columns 0.3s ease;
        }

            .lc-shell.collapsed {
                grid-template-columns: 70px 1fr;
            }

        /* === Sidebar === */
        .lc-sidebar {
            background: linear-gradient(180deg, var(--lc-primary) 0%, var(--lc-primary-600) 100%);
            color: #fff;
            padding: 1rem 0.75rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 3px 0 10px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
            overflow: hidden;
            position: relative;
        }

        .lc-shell.collapsed .lc-sidebar {
            width: 70px;
            padding: 1rem 0.4rem;
            align-items: center;
            justify-content: center;
        }

        /* === Brand === */
        .lc-brand {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .5rem .75rem;
            white-space: nowrap;
        }

        .lc-shell.collapsed .lc-brand div {
            display: none;
        }

        /* === Burger Button === */
        #toggleSidebar {
            color: #fff;
            background: none;
            border: none;
            margin-left: auto;
            transition: transform .3s ease;
        }

            #toggleSidebar:hover {
                transform: scale(1.1);
                color: #dbeafe;
            }

        .lc-shell.collapsed #toggleSidebar {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
        }

        /* === Nav Links === */
        .lc-nav a {
            display: flex;
            align-items: center;
            gap: .75rem;
            color: #e5e7eb;
            text-decoration: none;
            padding: .6rem .8rem;
            border-radius: .75rem;
            transition: all .2s ease;
            font-weight: 500;
            position: relative;
        }

            .lc-nav a:hover {
                background: rgba(255, 255, 255, .15);
                transform: translateX(2px);
            }

            .lc-nav a.active {
                background: rgba(255, 255, 255, .25);
                color: #fff;
                font-weight: 600;
                box-shadow: inset 4px 0 0 #fff;
                transition: all .3s ease;
            }

                .lc-nav a.active::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 4px;
                    height: 60%;
                    border-radius: 2px;
                    background-color: #fff;
                    box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
                }

        .lc-shell.collapsed .lc-nav a {
            justify-content: center;
            padding: .75rem 0;
        }

            .lc-shell.collapsed .lc-nav a i {
                margin: 0;
                font-size: 1.3rem;
            }

            .lc-shell.collapsed .lc-nav a span {
                display: none;
            }

        /* === Logout Button === */
        .lc-logout {
            margin-top: auto;
            padding-top: 1rem;
        }

            .lc-logout button {
                color: #fff;
                text-align: left;
                width: 100%;
                display: flex;
                align-items: center;
                gap: .5rem;
                padding: .6rem .75rem;
                border-radius: .75rem;
                background: none;
                border: none;
                transition: background .2s ease;
            }

                .lc-logout button:hover {
                    background: rgba(255, 255, 255, .15);
                }

        .lc-shell.collapsed .lc-logout span {
            display: none;
        }

        .lc-sidebar {
            height: 100vh;
            overflow-y: auto;
        }

        /* === Topbar === */
        .lc-topbar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: .5rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .lc-card {
            background: var(--lc-card);
            border: 1px solid var(--lc-border);
            border-radius: 1rem;
            box-shadow: 0 4px 20px rgba(2, 6, 23, .04);
        }

        .lc-content {
            background: var(--lc-bg);
            padding: 1.5rem 2rem;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        .lc-inner {
            max-width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .container-fluid {
            padding-left: 0;
            padding-right: 0;
        }

        main.lc-content,
        .content-wrapper,
        .container-fluid {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
    </style>
</head>
<link rel="shortcut icon" href="~/LinkcareLogo.ico" type="image/x-icon" />
<body>
    <div class="lc-shell">
        <!-- Sidebar -->
        <aside class="lc-sidebar">
            <div>
                <div class="lc-brand position-relative">
                    <div>
                        <div class="fw-bold">Link Care</div>
                        <div class="small" style="opacity:.85">Smart Clinic System</div>
                    </div>
                    <button id="toggleSidebar" class="ms-auto" title="Toggle Sidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                </div>

                <div class="px-3 text-uppercase small mt-2" style="opacity:.85">Admin</div>
                <nav class="lc-nav mt-2">
                    <a href="/Admin/AdminDashboard" data-page="Dashboard"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a>
                    <a href="/Admin/DoctorManagement" data-page="DoctorManagement"><i class="bi bi-person-badge"></i> <span>Doctor Management</span></a>
                    <a href="/Admin/Billing" data-page="Billing"><i class="bi bi-receipt"></i> <span>Billing</span></a>
                    <a href="/Admin/OnlineAppointment" data-page="OnlineAppointment"><i class="bi bi-person-video2"></i> <span>Manage Appointment</span></a>
                    <a href="/Admin/ServiceManagement" data-page="ServiceManagement"><i class="bi bi-briefcase"></i> <span>Service Management</span></a>
                    <a href="/Admin/Equipments" data-page="Equipments"><i class="bi bi-gear"></i> <span>Equipments</span></a>
                    <a href="/Admin/Reports" data-page="Reports"><i class="bi bi-bar-chart"></i> <span>Reports</span></a>
                </nav>
            </div>

            <!-- Logout -->
            <div class="lc-logout mt-auto">
                <button type="button" data-bs-toggle="modal" data-bs-target="#logoutModal">
                    <i class="bi bi-box-arrow-right"></i> <span>Logout</span>
                </button>
            </div>
        </aside>

        <!-- Main content -->
        <main class="lc-content">
            <div class="lc-inner">
                <div class="lc-topbar"></div>
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="logoutModalLabel"><i class="bi bi-box-arrow-right me-2"></i>Confirm Logout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to log out of your admin account?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="btn btn-danger">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const shell = document.querySelector(".lc-shell");
        const toggleBtn = document.getElementById("toggleSidebar");
        const navLinks = document.querySelectorAll(".lc-nav a");

        // Sidebar toggle persistence
        if (localStorage.getItem("sidebarState") === "collapsed") {
            shell.classList.add("collapsed");
        }

        toggleBtn.addEventListener("click", () => {
            shell.classList.toggle("collapsed");
            localStorage.setItem("sidebarState", shell.classList.contains("collapsed") ? "collapsed" : "expanded");
        });

        // Active link detection
        const currentPage = "@activePage";
        let matched = false;

        navLinks.forEach(link => {
            if (link.dataset.page === currentPage) {
                link.classList.add("active");
                matched = true;
            }
        });

        // fallback: auto-detect via URL path
        if (!matched) {
            const path = window.location.pathname.toLowerCase();
            navLinks.forEach(link => {
                if (path.includes(link.dataset.page.toLowerCase())) {
                    link.classList.add("active");
                }
            });
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
