@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<div class="container mt-5">
    <div class="card shadow p-4 rounded-4" style="max-width:600px;margin:auto;">
        <h2 class="fw-bold text-center">Registration Successful 🎉</h2>
        <p class="text-center text-muted">
            We've sent a confirmation email to <strong>@Model.Email</strong>.
            Please check your inbox (and spam folder) and confirm your account before logging in.
        </p>

        @if (Model.DisplayConfirmAccountLink)
        {
            <div class="alert alert-warning mt-3">
                (Development Mode) Confirm your account here:
                <a class="btn btn-sm btn-primary" href="@Model.EmailConfirmationUrl">Confirm Email</a>
            </div>
        }
    </div>
</div>
